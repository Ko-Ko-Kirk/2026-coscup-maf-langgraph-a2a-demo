# Microsoft Foundry project endpoint and one tool-capable model deployment.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=YOUR-DEPLOYMENT-NAME

# cli: local `az login`
# default: environment/workload identity/managed identity credential chain
# managed_identity: explicit Azure managed identity
AZURE_CREDENTIAL_MODE=cli
# AZURE_CLIENT_ID=

MAF_HOST=127.0.0.1
MAF_PORT=8001
MAF_PUBLIC_URL=http://127.0.0.1:8001/

LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=8002
LANGGRAPH_PUBLIC_URL=http://127.0.0.1:8002/

INVENTORY_AGENT_HOST=127.0.0.1
INVENTORY_AGENT_PORT=8003
INVENTORY_AGENT_PUBLIC_URL=http://127.0.0.1:8003/

# fixture is the safe default for a public clone.
# Set live explicitly to call Ko Ko's Azure App Service demo API.
INVENTORY_API_URL=https://koko-demo-api.azurewebsites.net/inventory/
INVENTORY_MODE=fixture
INVENTORY_TIMEOUT_SECONDS=5
INVENTORY_MAX_ATTEMPTS=2
INVENTORY_RETRY_DELAY_SECONDS=0.2
# A live failure becomes manual_review with visibly labelled fixture data.
INVENTORY_FALLBACK_TO_FIXTURE=true

A2A_TIMEOUT_SECONDS=120
MAX_INPUT_CHARS=20000
LOG_LEVEL=INFO
